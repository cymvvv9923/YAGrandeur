{
 "version": 8,
 "name": "simple-day",
 "sources": {
  "omt": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "© OpenStreetMap 기여자 · OpenFreeMap"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "bg",
   "type": "background",
   "paint": {
    "background-color": "#F3F4F6"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "omt",
   "source-layer": "water",
   "paint": {
    "fill-color": "#D6E2EE"
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "minzoom": 13,
   "filter": [
    "all",
    [
     "==",
     [
      "geometry-type"
     ],
     "LineString"
    ],
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "minor",
      "service"
     ],
     true,
     false
    ]
   ],
   "paint": {
    "line-color": "#FFFFFF",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     13,
     0.6,
     17,
     4
    ]
   }
  },
  {
   "id": "road-mid",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "minzoom": 10,
   "filter": [
    "all",
    [
     "==",
     [
      "geometry-type"
     ],
     "LineString"
    ],
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "secondary",
      "tertiary"
     ],
     true,
     false
    ]
   ],
   "paint": {
    "line-color": "#FFFFFF",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     10,
     0.6,
     14,
     2.5,
     17,
     7
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "minzoom": 6,
   "filter": [
    "all",
    [
     "==",
     [
      "geometry-type"
     ],
     "LineString"
    ],
    [
     "match",
     [
      "get",
      "class"
     ],
     [
      "motorway",
      "trunk",
      "primary"
     ],
     true,
     false
    ]
   ],
   "paint": {
    "line-color": "#E3E5EA",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     6,
     0.5,
     10,
     1.6,
     14,
     4,
     17,
     10
    ]
   }
  },
  {
   "id": "label-city",
   "type": "symbol",
   "source": "omt",
   "source-layer": "place",
   "minzoom": 9,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "city",
     "town"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ko"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     9,
     12,
     14,
     16
    ]
   },
   "paint": {
    "text-color": "#686A72",
    "text-halo-color": "#F3F4F6",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "label-suburb",
   "type": "symbol",
   "source": "omt",
   "source-layer": "place",
   "minzoom": 12,
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "suburb",
     "quarter",
     "neighbourhood"
    ],
    true,
    false
   ],
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:ko"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#9A9CA3",
    "text-halo-color": "#F3F4F6",
    "text-halo-width": 1.5
   }
  }
 ]
}